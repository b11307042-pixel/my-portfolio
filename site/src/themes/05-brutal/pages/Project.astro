---
import Layout from '../Layout.astro';
import Window from '../components/Window.astro';
import { render, type CollectionEntry } from 'astro:content';
import { u, img } from '../../../lib/site';

interface Props { entry: CollectionEntry<'projects'>; index: number; total: number; prev?: CollectionEntry<'projects'>; next?: CollectionEntry<'projects'> }
const { entry, index, total, next } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const colors = ['y', 'p', 'b', 'm'];
const color = colors[index % 4];
// 成果裡最後一組數字拿出來放大（「從 18 秒降到 9 秒」→ 9 秒）
const split = (r: string) => {
  const all = [...r.matchAll(/(\d[\d,.]*(?:\s*[–~-]\s*\d[\d,.]*)?)\s*(%|％|秒|步|筆|人|位|小時|分鐘|倍|個|場|次|元|週|天|本|張|件|篇|年|月|組|\+)?/g)];
  const m = all[all.length - 1];
  return m ? { num: m[1].replace(/\s+/g, ''), unit: m[2] || '' } : null;
};
---
<Layout title={d.title} description={d.summary} image={d.cover} page="project">
  <header class={`case-head c-${color}`}>
    <div class="wrap">
      <div class="case-top" data-in>
        <a class="back" href={u('/projects/')}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M19 12H6M12 19l-7-7 7-7" /></svg>所有作品</a>
        <span class="case-idx"><b>{String(index + 1).padStart(2, '0')}</b>/{String(total).padStart(2, '0')}</span>
      </div>
      <h1 class="case-title" data-in>{d.title}</h1>
      <p class="case-sum" data-in>{d.summary}</p>
      <dl class="case-meta" data-in>
        {d.role && <div><dt>角色</dt><dd>{d.role}</dd></div>}
        {d.period && <div><dt>時間</dt><dd>{d.period}</dd></div>}
        {d.tags.length > 0 && <div><dt>工具</dt><dd><ul class="tags">{d.tags.map((t) => <li>{t}</li>)}</ul></dd></div>}
        {d.links.length > 0 && <div><dt>連結</dt><dd class="case-links">{d.links.map((l) => <a href={l.url} target="_blank" rel="noopener">{l.label}<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7 17L17 7M9 7h8v8" /></svg></a>)}</dd></div>}
      </dl>
    </div>
  </header>

  <div class="wrap case-cover" data-in>
    <Window src={d.cover} alt={`${d.title} 主畫面`} label={`${entry.id}.app — 主畫面`} color={color} title={d.title} tag={d.tags[0]} note={d.results[0]} index={index} eager />
  </div>

  {d.results.length > 0 && (
    <section class="wrap sec-tight">
      <h2 class="sec-title"><span class="sec-en">RESULTS</span>成果</h2>
      <ul class:list={['results', `results-${Math.min(d.results.length, 3)}`]}>
        {d.results.map((r, i) => {
          const s = split(r);
          return (
            <li class={`res c-${colors[(index + i + 1) % 4]}`} data-rise data-tilt>
              <span class="res-n">{String(i + 1).padStart(2, '0')}</span>
              {s ? <strong class="res-big"><span data-count>{s.num}</span>{s.unit && <small>{s.unit}</small>}</strong> : <span class="res-star" aria-hidden="true"><svg viewBox="0 0 120 120"><path d="M60 0l10 22 22-12-4 25 25 3-19 17 19 17-25 3 4 25-22-12-10 22-10-22-22 12 4-25-25-3 19-17L6 38l25-3-4-25 22 12z" /></svg></span>}
              <p>{r}</p>
            </li>
          );
        })}
      </ul>
    </section>
  )}

  <section class="wrap case-body">
    <aside class="case-aside">
      <p class="case-aside-h">個案筆記</p>
      <p>{d.role || '專案'}</p>
      {d.period && <p class="mono">{d.period}</p>}
    </aside>
    <article class="prose" data-rise><Content /></article>
  </section>

  {d.gallery.length > 0 && (
    <section class="sec-tight gallery-sec">
      <div class="wrap gal-head">
        <h2 class="sec-title"><span class="sec-en">SCREENS</span>更多畫面</h2>
        {d.gallery.length > 2 && <p class="gal-hint">左右滑動看更多</p>}
      </div>
      <div class="gal" data-gal tabindex="0" aria-label="作品截圖">
        {d.gallery.map((g, i) => (
          <figure class={`gal-item c-${colors[(index + i) % 4]}`}>
            <img src={img(g.src)} alt={g.caption || `${d.title} 畫面 ${i + 1}`} loading="lazy" />
            {g.caption && <figcaption><span>{String(i + 1).padStart(2, '0')}</span>{g.caption}</figcaption>}
          </figure>
        ))}
      </div>
    </section>
  )}

  {next && next.id !== entry.id && (
    <a class={`next-proj c-${colors[(index + 1) % 4]}`} href={u(`/projects/${next.id}/`)}>
      <div class="wrap next-in">
        <span class="next-k">NEXT PROJECT</span>
        <span class="next-t">{next.data.title}</span>
        <span class="next-arrow" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M5 12h13M12 5l7 7-7 7" /></svg></span>
      </div>
    </a>
  )}
</Layout>
