---
import Layout from '../Layout.astro';
import Marquee from '../components/Marquee.astro';
import Badge from '../components/Badge.astro';
import NameTag from '../components/NameTag.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getProfile, getProjects, getExperience, getPosts, u, img, fmtDate } from '../../../lib/site';

const p = (await getProfile()).data;
const projects = await getProjects();
const featured = (projects.filter((x) => x.data.featured).length ? projects.filter((x) => x.data.featured) : projects).slice(0, 4);
const exp = (await getExperience()).slice(0, 3);
const posts = (await getPosts()).slice(0, 2);
const avatar = img(p.avatar);
const chars = [...p.name];
const skills = p.skills.flatMap((s) => s.items);
const colors = ['y', 'p', 'b', 'm'];
const firstHl = p.highlights[0];
---
<Layout page="home">
  <section class="hero">
    <div class="wrap hero-grid">
      <div class="hero-copy">
        <p class="hero-chips">
          <span class="chip chip-ink hero-chip">PORTFOLIO {new Date().getFullYear()}</span>
          <span class="chip hero-chip">{p.role}</span>
        </p>
        <h1 class="hero-name" style={`--n:${Math.max(chars.length, 2)}`}>
          <span class="sr">{p.name}</span>
          <span class="hn" aria-hidden="true">{chars.map((c) => <span class="hn-c"><span>{c}</span></span>)}</span>
        </h1>
        {p.nameEn && <p class="hero-en" aria-hidden="true">{p.nameEn}</p>}
        <p class="hero-tag"><mark>{p.tagline}</mark></p>
        <p class="hero-intro">{p.intro}</p>
        <div class="hero-ctas">
          <a class="btn btn-y btn-lg" href={u('/projects/')}>看我的作品<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M12 5l7 7-7 7" /></svg></a>
          <a class="btn btn-w btn-lg" href={u('/about/')}>認識我</a>
        </div>
      </div>

      <div class="hero-art" data-stage>
        {avatar ? (
          <figure class="hero-photo">
            <div class="win-bar"><span class="win-dots" aria-hidden="true"><i></i><i></i><i></i></span><span class="win-label">me.jpg</span></div>
            <img src={avatar} alt={`${p.name} 的照片`} loading="eager" />
          </figure>
        ) : (
          <NameTag name={p.name} nameEn={p.nameEn} role={p.role.split('｜')[0]} class="hero-photo" />
        )}
        {p.status && <Badge class="hero-badge" text="OPEN TO WORK · OPEN TO WORK · " />}
        <span class="stk stk-burst" data-drag><svg viewBox="0 0 120 120" aria-hidden="true"><path d="M60 0l10 22 22-12-4 25 25 3-19 17 19 17-25 3 4 25-22-12-10 22-10-22-22 12 4-25-25-3 19-17L6 38l25-3-4-25 22 12z" /></svg><b>HI!</b></span>
        {p.location && <span class="stk stk-pill" data-drag><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 22s7-7.5 7-13a7 7 0 1 0-14 0c0 5.5 7 13 7 13z" /><circle cx="12" cy="9" r="2.5" /></svg>{p.location}</span>}
        {firstHl && <span class="stk stk-num" data-drag><b>{firstHl.value}</b><small>{firstHl.label}</small></span>}
        <span class="stk-arrow" aria-hidden="true">
          <svg viewBox="0 0 120 60"><path d="M6 48 C 30 10, 70 6, 104 22" /><path d="M92 10l14 13-18 6" /></svg>
          <em>拖拖看</em>
        </span>
      </div>
    </div>
    {p.status && (
      <p class="hero-status wrap"><span class="hs-in"><span class="pulse" aria-hidden="true"></span>{p.status}</span></p>
    )}
  </section>

  {skills.length > 0 && (
    <div class="mq-stack">
      <Marquee items={skills} color="y" size="lg" tilt={-2} />
      {p.interests.length > 0 && <Marquee items={p.interests.map((i) => i.split('：')[0])} color="p" dir="right" tilt={1.5} />}
    </div>
  )}

  {p.highlights.length > 0 && (
    <section class="sec wrap">
      <div class="sec-head">
        <h2 class="sec-title"><span class="sec-en">BY THE NUMBERS</span>數字說話</h2>
      </div>
      <ul class:list={['hl', `hl-${Math.min(p.highlights.length, 4)}`]}>
        {p.highlights.map((h, i) => (
          <li class={`hl-item c-${colors[i % 4]}`} data-rise data-tilt style={`--len:${Math.max([...h.value].length, 2.4)}`}>
            <strong class="hl-v" data-count>{h.value}</strong>
            <span class="hl-l">{h.label}</span>
            <span class="hl-i" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
          </li>
        ))}
      </ul>
    </section>
  )}

  {featured.length > 0 && (
    <section class="sec wrap">
      <div class="sec-head">
        <h2 class="sec-title"><span class="sec-en">SELECTED WORK</span>精選作品</h2>
        <a class="btn btn-w btn-sm" href={u('/projects/')}>全部 {projects.length} 件作品</a>
      </div>
      <div class="pc-rows">
        {featured.map((x, i) => <div data-rise><ProjectCard entry={x} index={i} layout="row" /></div>)}
      </div>
    </section>
  )}

  <section class="sec wrap">
    <div class="about-band" data-rise>
      <div class="ab-left">
        <h2 class="sec-title"><span class="sec-en">ABOUT ME</span>關於我</h2>
        {p.quote && <blockquote class="ab-quote"><span>{p.quote}</span></blockquote>}
      </div>
      <div class="ab-right">
        {p.traits.length > 0 && (
          <ul class="ab-traits">
            {p.traits.map((t, i) => <li><span class={`ab-n c-${colors[(i + 1) % 4]}`}>{i + 1}</span>{t.title}</li>)}
          </ul>
        )}
        <a class="btn btn-ink" href={u('/about/')}>讀完整的自我介紹<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h13M12 5l7 7-7 7" /></svg></a>
      </div>
    </div>
  </section>

  {exp.length > 0 && (
    <section class="sec wrap">
      <div class="sec-head">
        <h2 class="sec-title"><span class="sec-en">EXPERIENCE</span>最近在做</h2>
        <a class="btn btn-w btn-sm" href={u('/experience/')}>完整經歷</a>
      </div>
      <ol class="tix">
        {exp.map((e, i) => (
          <li class="tix-item" data-rise>
            <span class={`tix-type c-${colors[(i + 2) % 4]}`}>{e.data.type || '經歷'}</span>
            <div class="tix-main">
              <h3>{e.data.title}</h3>
              <p>{e.data.org}</p>
            </div>
            <span class="tix-period">{e.data.period}</span>
          </li>
        ))}
      </ol>
    </section>
  )}

  {posts.length > 0 && (
    <section class="sec wrap">
      <div class="sec-head">
        <h2 class="sec-title"><span class="sec-en">WRITING</span>最近寫的</h2>
        <a class="btn btn-w btn-sm" href={u('/blog/')}>所有文章</a>
      </div>
      <div class="pp-grid">
        {posts.map((x, i) => (
          <a class={`pp c-${colors[(i + 1) % 4]}`} href={u(`/blog/${x.id}/`)} data-rise data-tilt>
            <span class="pp-date">{fmtDate(x.data.date)}</span>
            <h3>{x.data.title}</h3>
            <p>{x.data.summary}</p>
            <span class="pc-go" aria-hidden="true"><span>閱讀</span><svg viewBox="0 0 24 24"><path d="M5 12h13M12 5l7 7-7 7" /></svg></span>
          </a>
        ))}
      </div>
    </section>
  )}
</Layout>
