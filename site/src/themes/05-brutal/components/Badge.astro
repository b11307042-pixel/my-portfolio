---
// 旋轉圓形徽章（SVG textPath）：OPEN TO WORK
interface Props { text?: string; center?: string; color?: string; class?: string }
const { text = 'OPEN TO WORK · OPEN TO WORK · ', center = '', color = 'var(--yellow)', class: cls = '' } = Astro.props;
const id = 'bp' + Math.random().toString(36).slice(2, 8);
---
<div class={`badge ${cls}`} style={`--badge:${color}`}>
  <svg class="badge-ring" viewBox="0 0 200 200" aria-hidden="true">
    <defs><path id={id} d="M100,100 m-72,0 a72,72 0 1,1 144,0 a72,72 0 1,1 -144,0" /></defs>
    <circle cx="100" cy="100" r="97" class="badge-bg" />
    <text><textPath href={`#${id}`} textLength="452">{text}</textPath></text>
  </svg>
  <span class="badge-c">
    {center ? <span class="badge-txt">{center}</span> : (
      <svg viewBox="0 0 40 40" aria-hidden="true"><path d="M20 0l5 13 15-3-11 10 11 10-15-3-5 13-5-13-15 3 11-10L0 10l15 3z" /></svg>
    )}
  </span>
</div>
