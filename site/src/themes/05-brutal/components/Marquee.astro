---
// 無限跑馬燈：內容重複兩半，JS 讓它往左跑，捲動越快跑越快、往回捲會反向
interface Props { items: string[]; color?: 'y' | 'p' | 'b' | 'm' | 'ink'; dir?: 'left' | 'right'; tilt?: number; size?: 'lg' | 'md' }
const { items, color = 'y', dir = 'left', tilt = 0, size = 'md' } = Astro.props;
const list = items.filter(Boolean);
// 每一半至少 12 個，寬螢幕才不會露出空白
const half: string[] = [];
while (list.length && half.length < 12) half.push(...list);
---
{list.length > 0 && (
  <div class:list={['mq', `mq-${color}`, `mq-${size}`]} data-marquee data-dir={dir} style={tilt ? `--tilt:${tilt}deg` : undefined} aria-label={list.join('、')} role="marquee">
    <div class="mq-track" aria-hidden="true">
      {[0, 1].map(() => (
        <div class="mq-half">
          {half.map((t) => (
            <span class="mq-item">
              <span>{t}</span>
              <svg class="mq-star" viewBox="0 0 40 40"><path d="M20 0l5 13 15-3-11 10 11 10-15-3-5 13-5-13-15 3 11-10L0 10l15 3z" /></svg>
            </span>
          ))}
        </div>
      ))}
    </div>
  </div>
)}
