---
// 液態玻璃：全站外框。流動漸層背景、玻璃導覽、液態游標、全站動畫都在這裡。
import Seo from '../../shared/Seo.astro';
import Header from './components/Header.astro';
import Footer from './components/Footer.astro';
import { config } from '../../lib/site';
import './glass.css';

interface Props { title?: string; description?: string; image?: string; page?: string }
const { title, description, image, page = 'page' } = Astro.props;
---
<!doctype html>
<html lang={config.lang || 'zh-Hant'}>
  <head>
    <Seo title={title} description={description} image={image} />
  </head>
  <body data-page={page}>
    <a class="skip" href="#main">跳到主要內容</a>
    <div class="mesh" aria-hidden="true">
      <div class="mesh-move" data-mesh>
        <span class="blob b1"></span>
        <span class="blob b2"></span>
        <span class="blob b3"></span>
        <span class="blob b4"></span>
        <span class="blob b5"></span>
      </div>
      <span class="mesh-sheen"></span>
    </div>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>

<script>
  import { gsap, ScrollTrigger, SplitText, still, smoothScroll, onReady, canHover } from '../../lib/motion';

  const html = document.documentElement;

  // 手機選單（不靠動畫，still 也能用）
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const sheet = document.querySelector<HTMLElement>('[data-menu]');
  const setMenu = (open: boolean) => {
    html.classList.toggle('menu-open', open);
    toggle?.setAttribute('aria-expanded', String(open));
    toggle?.setAttribute('aria-label', open ? '關閉選單' : '開啟選單');
    if (open && !still && sheet) {
      gsap.from(sheet.querySelector('.sheet-panel'), { y: -20, scale: 0.96, autoAlpha: 0, filter: 'blur(16px)', duration: 0.7, ease: 'expo.out', clearProps: 'filter' });
      gsap.from(sheet.querySelectorAll('.sheet-link'), { y: 16, autoAlpha: 0, duration: 0.6, stagger: 0.04, ease: 'expo.out', delay: 0.08 });
    }
  };
  toggle?.addEventListener('click', () => setMenu(!html.classList.contains('menu-open')));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setMenu(false); });
  sheet?.addEventListener('click', (e) => { if (e.target === sheet) setMenu(false); });
  sheet?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));

  // 頁首捲動後玻璃變厚
  const onScroll = () => html.classList.toggle('scrolled', window.scrollY > 24);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // 複製 email
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) => {
    b.addEventListener('click', async () => {
      try { await navigator.clipboard.writeText(b.dataset.copy || ''); } catch { return; }
      const label = b.querySelector('.copy-label');
      const old = label?.textContent;
      b.classList.add('copied');
      if (label) label.textContent = '已複製';
      setTimeout(() => { b.classList.remove('copied'); if (label && old) label.textContent = old; }, 1800);
    });
  });

  // 玻璃反光跟著游標（只寫 CSS 變數；傾斜在 onReady 裡加）
  if (canHover) {
    document.addEventListener('pointermove', (e) => {
      const el = (e.target as HTMLElement)?.closest?.<HTMLElement>('.glass');
      if (!el) return;
      const r = el.getBoundingClientRect();
      el.style.setProperty('--mx', `${((e.clientX - r.left) / r.width) * 100}%`);
      el.style.setProperty('--my', `${((e.clientY - r.top) / r.height) * 100}%`);
    }, { passive: true });
  }

  smoothScroll({ lerp: 0.1 });

  onReady(() => {
    const hidden: (() => void)[] = [];
    const shown: (() => void)[] = [];
    document.addEventListener('visibilitychange', () => (document.hidden ? hidden : shown).forEach((f) => f()));

    // 1. 漸層慢慢流動（分頁看不到時暫停）
    const flow = gsap.timeline({ repeat: -1, yoyo: true, defaults: { ease: 'sine.inOut', duration: 14 } });
    flow.to('.b1', { xPercent: 30, yPercent: 18, scale: 1.2 }, 0)
      .to('.b2', { xPercent: -26, yPercent: 24, scale: 0.85 }, 0)
      .to('.b3', { xPercent: 22, yPercent: -20, scale: 1.15 }, 0)
      .to('.b4', { xPercent: -18, yPercent: -14, scale: 1.3 }, 0)
      .to('.b5', { xPercent: 14, yPercent: 26, scale: 0.9 }, 0)
      .to('.mesh-sheen', { rotate: 50 }, 0);
    hidden.push(() => flow.pause());
    shown.push(() => flow.resume());

    // 2. 捲動時漸層跟著轉、色塊錯開移動
    gsap.to('[data-mesh]', { rotate: 40, scale: 1.15, ease: 'none', scrollTrigger: { start: 0, end: 'max', scrub: 1.2 } });
    gsap.to('.b2', { y: '-28vh', ease: 'none', scrollTrigger: { start: 0, end: 'max', scrub: 1.6 } });
    gsap.to('.b4', { y: '22vh', ease: 'none', scrollTrigger: { start: 0, end: 'max', scrub: 1.6 } });

    // 3. 進場：玻璃一片片滑進來，從模糊變清楚
    gsap.from('.mesh', { autoAlpha: 0, scale: 1.08, duration: 1.8, ease: 'power2.out' });
    gsap.from('[data-head]', { y: -30, autoAlpha: 0, filter: 'blur(14px)', duration: 1.1, ease: 'expo.out', delay: 0.1, clearProps: 'filter' });
    gsap.from('[data-pane]', {
      y: 90, rotateX: -14, scale: 0.94, autoAlpha: 0, filter: 'blur(22px)', transformPerspective: 1200, transformOrigin: '50% 100%',
      duration: 1.5, ease: 'expo.out', stagger: 0.12, delay: 0.2, clearProps: 'filter,transform',
    });
    document.querySelectorAll<HTMLElement>('[data-split]').forEach((el, i) => {
      const split = SplitText.create(el, { type: 'chars', charsClass: 'ch' });
      gsap.from(split.chars, {
        yPercent: 60, opacity: 0, filter: 'blur(10px)', duration: 1.2, ease: 'expo.out',
        stagger: Math.min(0.03, 0.8 / split.chars.length), delay: 0.45 + i * 0.1,
        onComplete: () => split.revert(),
      });
    });
    gsap.from('[data-intro]', { y: 20, autoAlpha: 0, duration: 1.1, ease: 'expo.out', stagger: 0.07, delay: 0.7 });

    // 4. 捲到才出現：玻璃從模糊中浮起
    ScrollTrigger.batch('[data-reveal]', {
      start: 'top 90%', once: true,
      onEnter: (els) => gsap.from(els, { y: 50, scale: 0.97, autoAlpha: 0, filter: 'blur(14px)', duration: 1.2, ease: 'expo.out', stagger: 0.08, clearProps: 'filter,scale' }),
    });

    // 5. 裝置框：捲動時從傾斜到正面
    document.querySelectorAll<HTMLElement>('[data-device]').forEach((el) => {
      gsap.fromTo(el, { rotateX: 18, y: 50, scale: 0.92, transformPerspective: 1400 }, {
        rotateX: 0, y: 0, scale: 1, ease: 'none',
        scrollTrigger: { trigger: el, start: 'top 98%', end: 'top 35%', scrub: 0.8 },
      });
    });

    // 6. 數字跑上來
    document.querySelectorAll<HTMLElement>('[data-count]').forEach((el) => {
      const end = Number(el.dataset.count);
      const suffix = el.dataset.suffix || '';
      const o = { v: 0 };
      gsap.to(o, {
        v: end, duration: 1.8, ease: 'expo.out',
        scrollTrigger: { trigger: el, start: 'top 92%', once: true },
        onStart: () => { el.textContent = '0' + suffix; },
        onUpdate: () => { el.textContent = Math.round(o.v).toLocaleString('en-US') + suffix; },
      });
    });

    // 時間軸：漸層玻璃管跟著捲動填滿
    document.querySelectorAll('[data-line]').forEach((el) => {
      gsap.from(el, { scaleY: 0, ease: 'none', scrollTrigger: { trigger: el.closest('.timeline'), start: 'top 70%', end: 'bottom 70%', scrub: true } });
    });

    // 7. 閱讀進度
    const bar = document.querySelector<HTMLElement>('[data-progress]');
    if (bar) gsap.fromTo(bar, { scaleX: 0 }, { scaleX: 1, ease: 'none', scrollTrigger: { trigger: '.post', start: 'top top', end: 'bottom bottom', scrub: true } });

    // 8. 技能跑馬燈
    document.querySelectorAll<HTMLElement>('[data-marquee]').forEach((el) => {
      const track = el.querySelector('.marquee-track');
      if (!track) return;
      el.classList.add('is-running');
      const t = gsap.to(track, { xPercent: -50, duration: 46, ease: 'none', repeat: -1 });
      if (canHover) {
        el.addEventListener('mouseenter', () => gsap.to(t, { timeScale: 0.2, duration: 0.6 }));
        el.addEventListener('mouseleave', () => gsap.to(t, { timeScale: 1, duration: 0.6 }));
      }
      hidden.push(() => t.pause());
      shown.push(() => t.resume());
    });

    if (canHover) {
      // 9. 玻璃面板跟著游標傾斜
      document.querySelectorAll<HTMLElement>('[data-tilt]').forEach((el) => {
        el.addEventListener('pointerenter', () => gsap.set(el, { transformPerspective: 1000 }));
        const big = el.offsetWidth > 700;
        const amt = big ? 3 : 7;
        const tilt = (x: number, y: number) => gsap.to(el, { rotateY: x, rotateX: y, duration: 0.6, ease: 'power3.out', overwrite: 'auto' });
        el.addEventListener('pointermove', (e) => {
          const r = el.getBoundingClientRect();
          tilt(((e.clientX - r.left) / r.width - 0.5) * amt * 2, -((e.clientY - r.top) / r.height - 0.5) * amt * 2);
        });
        el.addEventListener('pointerleave', () => tilt(0, 0));
      });

      // 10. 磁吸按鈕
      document.querySelectorAll<HTMLElement>('.magnet').forEach((el) => {
        const xTo = gsap.quickTo(el, 'x', { duration: 0.5, ease: 'power3.out' });
        const yTo = gsap.quickTo(el, 'y', { duration: 0.5, ease: 'power3.out' });
        el.addEventListener('pointermove', (e) => {
          const r = el.getBoundingClientRect();
          xTo((e.clientX - r.left - r.width / 2) * 0.3);
          yTo((e.clientY - r.top - r.height / 2) * 0.4);
        });
        el.addEventListener('pointerleave', () => { xTo(0); yTo(0); });
      });

      // 11. 液態游標：一顆會被拉長的玻璃水滴，碰到連結變大
      const blob = document.createElement('div');
      blob.className = 'goo';
      blob.setAttribute('aria-hidden', 'true');
      blob.innerHTML = '<span></span>';
      document.body.appendChild(blob);
      const drop = blob.querySelector('span')!;
      const pos = { x: innerWidth / 2, y: innerHeight / 2 };
      const mouse = { x: pos.x, y: pos.y };
      let seen = false;
      window.addEventListener('pointermove', (e) => {
        mouse.x = e.clientX; mouse.y = e.clientY;
        if (!seen) { seen = true; pos.x = mouse.x; pos.y = mouse.y; html.classList.add('has-goo'); }
      }, { passive: true });
      document.addEventListener('pointerleave', () => { html.classList.remove('has-goo'); seen = false; });
      const tick = () => {
        const dt = 1 - Math.pow(0.82, gsap.ticker.deltaRatio());
        const dx = mouse.x - pos.x, dy = mouse.y - pos.y;
        pos.x += dx * dt; pos.y += dy * dt;
        const v = Math.min(Math.hypot(dx, dy) / 160, 0.7);
        const a = (Math.atan2(dy, dx) * 180) / Math.PI;
        gsap.set(blob, { x: pos.x, y: pos.y });
        gsap.set(drop, { rotate: a, scaleX: 1 + v, scaleY: 1 - v * 0.45 });
      };
      gsap.ticker.add(tick);
      hidden.push(() => gsap.ticker.remove(tick));
      shown.push(() => gsap.ticker.add(tick));
      document.querySelectorAll<HTMLElement>('a, button, [data-tilt]').forEach((el) => {
        el.addEventListener('pointerenter', () => blob.classList.add(el.matches('a, button') ? 'on-link' : 'on-glass'));
        el.addEventListener('pointerleave', () => blob.classList.remove('on-link', 'on-glass'));
      });
    }

    ScrollTrigger.refresh();
  });
</script>
