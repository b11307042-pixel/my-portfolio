---
import Layout from '../Layout.astro';
import Device from '../components/Device.astro';
import W from '../components/W.astro';
import { img, u } from '../../../lib/site';
import { render } from 'astro:content';

const { entry, index = 0, total = 1, next } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const cover = img(d.cover);
const num = (s: string) => { const all = s.match(/\d[\d,.]*(?:\s*[–~-]\s*\d[\d,.]*)?\s*(?:%|倍|位|人|筆|本|小時|分鐘|秒|步|場|名|次|個)/g); return all ? (/降到|減到|提高到|降至|升到|變成/.test(s) ? all[all.length - 1] : all[0]) : undefined; };
---
<Layout title={d.title} description={d.summary} image={d.cover || undefined} page="project">
  <article class="case">
    <header class="case-hero wrap glass glass-xl" data-pane>
      <a class="back" href={u('/projects/')} data-intro><span aria-hidden="true">←</span> 所有作品</a>
      <p class="eyebrow" data-intro>Case study · {String(index + 1).padStart(2, '0')} / {String(total).padStart(2, '0')}</p>
      <h1 class="case-title"><span data-split><W text={d.title} /></span></h1>
      <p class="page-lead" data-intro>{d.summary}</p>
      <dl class="case-meta" data-intro>
        {d.role && <div><dt>我負責</dt><dd>{d.role}</dd></div>}
        {d.period && <div><dt>期間</dt><dd>{d.period}</dd></div>}
        {d.tags.length > 0 && <div><dt>技術</dt><dd class="chips">{d.tags.map((t: string) => <span class="chip">{t}</span>)}</dd></div>}
        {d.links.length > 0 && <div><dt>連結</dt><dd class="case-links">{d.links.map((l: any) => <a href={u(l.url)} target="_blank" rel="noopener">{l.label} ↗</a>)}</dd></div>}
      </dl>
    </header>

    {cover && <section class="stage wrap" aria-label="作品畫面">
      <Device src={cover} alt={`${d.title} 畫面`} label={d.title} eager />
    </section>}

    {d.results.length > 0 && (
      <section class="wrap results" aria-label="成果">
        <p class="eyebrow eyebrow-pill" data-reveal>Outcome</p>
        <ul class="result-grid" style={`--n:${Math.min(d.results.length, 3)}`}>
          {d.results.map((r: string) => {
            const n = num(r);
            return (
              <li class="glass" data-reveal data-tilt>
                {n ? <strong class="result-n">{n}</strong> : <span class="result-mark" aria-hidden="true"></span>}
                <span>{r}</span>
              </li>
            );
          })}
        </ul>
      </section>
    )}

    <section class="wrap case-body">
      <div class="prose prose-lg glass prose-pane" data-reveal><Content /></div>
    </section>

    {d.gallery.length > 0 && (
      <section class="wrap gallery" aria-label="更多畫面">
        <p class="eyebrow eyebrow-pill" data-reveal>Gallery</p>
        <div class="gallery-row">
          {d.gallery.map((g: any) => (
            <figure class="shot glass" data-reveal data-tilt>
              <div class="shot-frame"><img src={img(g.src)} alt={g.caption || d.title} loading="lazy" /></div>
              {g.caption && <figcaption>{g.caption}</figcaption>}
            </figure>
          ))}
        </div>
      </section>
    )}

    {next && next.id !== entry.id && (
      <nav class="wrap next-case" aria-label="下一個作品">
        <a class="glass next-card" data-tilt href={u(`/projects/${next.id}/`)}>
          <span class="eyebrow">Next project</span>
          <span class="next-title">{next.data.title}</span>
          <span class="next-sum">{next.data.summary}</span>
          <span class="next-go" aria-hidden="true">→</span>
        </a>
      </nav>
    )}
  </article>
</Layout>
