---
// 09 柔和黏土：整站外框（背景泡泡、浮動膠囊導覽、頁尾）
import Seo from '../../shared/Seo.astro';
import Header from './components/Header.astro';
import Footer from './components/Footer.astro';
import { config } from '../../lib/site';
import './styles.css';

interface Props { title?: string; description?: string; image?: string; page?: string }
const { title, description, image, page = 'page' } = Astro.props;
---
<!doctype html>
<html lang={config.lang} data-page={page}>
<head>
  <Seo title={title} description={description} image={image} />
</head>
<body>
  <a class="skip" href="#main">跳到內容</a>
  <div class="sky" aria-hidden="true">
    <span class="blob b1" data-blob></span>
    <span class="blob b2" data-blob></span>
    <span class="blob b3" data-blob></span>
    <span class="blob b4" data-blob></span>
    <span class="grain"></span>
  </div>
  <Header />
  <main id="main">
    <slot />
  </main>
  <Footer />
  <script>
    import './scripts/soft';
  </script>
  <script is:inline>if (location.search.includes('shot')) document.querySelectorAll('img[loading=lazy]').forEach((i) => { i.loading = 'eager'; });</script>
</body>
</html>
