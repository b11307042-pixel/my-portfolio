---
import Layout from '../Layout.astro';
import Win from '../components/Win.astro';
import Icon from '../components/Icon.astro';
import { getPosts, u, fmtDate, readMinutes } from '../../../lib/site';
const posts = await getPosts();
---
<Layout title="文章" stage="page">
  <Win id="w-main" title="Writing" icon="folder" class="w-full" main label="文章資料夾" info={`${posts.length} 個項目`} infoR="依日期排列">
    <header class="doc-head">
      <p class="kicker">Writing</p>
      <h1 class="doc-title">文章</h1>
      <p class="doc-lead">做作品時的心得和學習筆記。</p>
    </header>
    {posts.length > 0 ? (
      <div class="table">
        <div class="tr th" aria-hidden="true"><span>名稱</span><span>日期</span><span>長度</span><span>標籤</span></div>
        <ul>
          {posts.map((x) => (
            <li>
              <a class="tr" href={u(`/blog/${x.id}/`)}>
                <span class="td-name"><Icon kind="text" size={32} /><span><span class="td-t">{x.data.title}</span><span class="td-s">{x.data.summary}</span></span></span>
                <time class="td-d" datetime={x.data.date.toISOString()}>{fmtDate(x.data.date)}</time>
                <span class="td-m">{readMinutes(x.body)} 分鐘</span>
                <span class="td-k">{x.data.tags.slice(0, 3).map((t) => <span class="tag">{t}</span>)}</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    ) : (
      <div class="empty"><Icon kind="folder" size={48} /><p>這個資料夾是空的，第一篇正在寫。</p></div>
    )}
  </Win>
</Layout>
