---
// 履歷抬頭：大字襯線名字＋英文簽名（沒有英文名就不簽）、身份、地點、狀態、按鈕（首頁與關於頁用）
import Avatar from './Avatar.astro';
import { getProfile, u } from '../../../lib/site';
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
const p = (await getProfile()).data;
const len = [...p.name].length;
---
<header class:list={['id', { compact }]}>
  <div class="id-row" data-in>
    <div class="id-tx">
      <h1 class:list={['id-name', { long: len > 4 }]}>{p.name}</h1>
      {p.nameEn && <p class="id-sig" aria-label={p.nameEn}>{p.nameEn}</p>}
      <p class="id-role">{p.role}</p>
    </div>
    <Avatar size={compact ? 72 : 96} class="id-av" />
  </div>
  <p class="id-meta mono" data-in>
    {p.location && <span>{p.location}</span>}
    {p.status && <span class="id-status"><i class="dot" aria-hidden="true"></i>{p.status}</span>}
    {p.email && <span class="print-only">{p.email}</span>}
  </p>
  {!compact && (
    <div class="id-btns no-print" data-in>
      {p.email && (
        <button type="button" class="btn primary" data-copy={p.email}>
          <svg viewBox="0 0 16 16" aria-hidden="true"><rect x="5.5" y="5.5" width="8" height="8" rx="1" fill="none" stroke="currentColor" stroke-width="1.3"/><path d="M10.5 3.5V3a1 1 0 0 0-1-1h-6a1 1 0 0 0-1 1v6a1 1 0 0 0 1 1h.5" fill="none" stroke="currentColor" stroke-width="1.3"/></svg>
          <span data-copy-label>複製 Email</span>
        </button>
      )}
      <a class="btn" href={u('/contact/')}>聯絡我</a>
      {p.resume && <a class="btn" href={u(p.resume)} target="_blank" rel="noopener">履歷 PDF</a>}
      <button type="button" class="btn ghost" data-print>列印成紙本<kbd class="kbd">⌘P</kbd></button>
    </div>
  )}
</header>
