---
interface Props { class?: string; dir?: 'right' | 'left' | 'up' | 'down' | 'ne' }
const { class: cls = '', dir = 'right' } = Astro.props;
const rot = { right: 0, left: 180, up: -90, down: 90, ne: -45 }[dir];
---
<svg class:list={['arrow', cls]} viewBox="0 0 24 24" aria-hidden="true" style={rot ? `transform:rotate(${rot}deg)` : undefined}><path d="M2 12h19M14 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="square" vector-effect="non-scaling-stroke" /></svg>
