---
import { kp } from '../components/kp';
import Layout from '../Layout.astro';
import Media from '../components/Media.astro';
import { u, fmtDate, readMinutes, getProfile } from '../../../lib/site';
import { render } from 'astro:content';

const { entry, prev, next } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const p = (await getProfile()).data;
---
<Layout title={d.title} description={d.summary} image={d.cover} page="post">
  <article class="po">
    <header class="po-head">
      <div class="cs-meta mono" data-hero-fade>
        <a class="ul" href={u('/blog/')}>← Writing</a>
        <span>{fmtDate(d.date)}</span>
        <span>{readMinutes(entry.body)} min read</span>
        <span class="cs-of">{d.tags.join(' · ')}</span>
      </div>
      <span class="rule"></span>
      <h1 class:list={['po-title', kp(d.title)]} data-hero-lines>{d.title}</h1>
      <p class:list={['po-sum', kp(d.summary)]} data-hero-lines>{d.summary}</p>
    </header>
    {d.cover && <div class="po-cover"><Media src={d.cover} alt="" hero /></div>}
    <div class="po-body">
      <aside class="po-side">
        <dl class="sheet">
          <div><dt>Author</dt><dd>{p.name}</dd></div>
          <div><dt>Date</dt><dd><time datetime={d.date.toISOString()}>{fmtDate(d.date)}</time></dd></div>
          <div><dt>Length</dt><dd>{readMinutes(entry.body)} 分鐘</dd></div>
          {d.tags.length > 0 && <div><dt>Tags</dt><dd class="sheet-tags">{d.tags.map((t) => <span>{t}</span>)}</dd></div>}
        </dl>
      </aside>
      <div class="prose po-prose"><Content /><p class="po-end" aria-hidden="true"><span class="sq"></span></p></div>
    </div>
    {(prev || next) && (
      <nav class="pager" aria-label="其他文章">
        {prev ? <a href={u(`/blog/${prev.id}/`)}><span class="mono">← Newer</span><span class:list={['pager-t', kp(prev.data.title)]}>{prev.data.title}</span></a> : <span></span>}
        {next ? <a class="pager-next" href={u(`/blog/${next.id}/`)}><span class="mono">Older →</span><span class:list={['pager-t', kp(next.data.title)]}>{next.data.title}</span></a> : <span></span>}
      </nav>
    )}
  </article>
</Layout>
