---
import Layout from '../Layout.astro';
import Icon from '../components/Icon.astro';
import { getPosts, u, img, fmtDate, readMinutes } from '../../../lib/site';
const list = await getPosts();
const [lead, ...rest] = list;
const ym = (d: Date) => `${d.getFullYear()} 年 ${d.getMonth() + 1} 月`;
---
<Layout title="文章" page="blog">
  <header class="phead wrap">
    <p class="kicker">文章</p>
    <h1 class="h1" data-intro>邊做邊寫下來。</h1>
    <p class="lede" data-intro>學習筆記、做專案的心得，{list.length} 篇。</p>
  </header>
  <div class="wrap blist">
    {lead && (
      <a class="card bcard lead" href={u(`/blog/${lead.id}/`)} data-rise>
        <div class="bc-art">
          {img(lead.data.cover) ? <img src={img(lead.data.cover)} alt="" /> : (
            <>
              <p class="bc-ym">{ym(lead.data.date)}・最新</p>
              <p class="bc-day">{String(lead.data.date.getDate()).padStart(2, '0')}</p>
              {lead.data.tags.length > 0 && <p class="chips">{lead.data.tags.map((t) => <span>{t}</span>)}</p>}
            </>
          )}
        </div>
        <div class="bc-tx">
          <p class="pc-meta"><time datetime={lead.data.date.toISOString()}>{fmtDate(lead.data.date)}</time><span>{readMinutes(lead.body)} 分鐘閱讀</span></p>
          <h2 class="bc-t">{lead.data.title}</h2>
          <p class="bc-s">{lead.data.summary}</p>
          <span class="tlink">閱讀 <Icon name="chev" /></span>
        </div>
      </a>
    )}
    {rest.map((x) => (
      <a class="card bcard" href={u(`/blog/${x.id}/`)} data-rise>
        <p class="pc-meta"><time datetime={x.data.date.toISOString()}>{fmtDate(x.data.date)}</time><span>{readMinutes(x.body)} 分鐘閱讀</span></p>
        <h2 class="bc-t">{x.data.title}</h2>
        <p class="bc-s">{x.data.summary}</p>
        {x.data.tags.length > 0 && <p class="chips">{x.data.tags.map((t) => <span>{t}</span>)}</p>}
        <span class="tlink">閱讀 <Icon name="chev" /></span>
      </a>
    ))}
  </div>
</Layout>
<script>
  import { gsap, onReady } from '../../../lib/motion';
  onReady(() => {
    gsap.from('.phead .kicker, [data-intro]', { y: 30, opacity: 0, filter: 'blur(8px)', duration: 1.3, ease: 'expo.out', stagger: 0.1 });
    gsap.from('.blist > :first-child', { y: 70, opacity: 0, duration: 1.4, ease: 'expo.out', delay: 0.25 });
  });
</script>
