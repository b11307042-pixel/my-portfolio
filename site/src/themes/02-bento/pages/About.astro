---
import Layout from '../Layout.astro';
import Icon from '../components/Icon.astro';
import Cta from '../components/Cta.astro';
import Phrases from '../components/Phrases.astro';
import { getProfile, img } from '../../../lib/site';
import { render } from 'astro:content';
const prof = await getProfile();
const p = prof.data;
const { Content } = await render(prof);
const main = img(p.avatar) || img(p.photos[0]);
const second = p.avatar ? img(p.photos[0]) : img(p.photos[1]);
const facts = [
  p.role && ['身份', p.role.split(/[｜|]/)[0]],
  p.location && ['地點', p.location],
  p.status && ['現在', p.status],
  p.email && ['Email', p.email],
].filter(Boolean) as string[][];
---
<Layout title="關於" page="about">
  <header class="phead wrap">
    <p class="kicker">關於{p.name}</p>
    <h1 class="h1" data-intro><Phrases text={p.tagline} /></h1>
    {p.quote && <p class="lede" data-intro>「{p.quote}」</p>}
  </header>

  <section class="wrap about-hero">
    {main ? (
      <div class:list={['about-media', { one: !second && facts.length === 0 }]}>
        <figure data-zoom><img src={main} alt={p.name} loading="eager" /></figure>
        {second ? (
          <div class="about-side">
            <figure><img src={second} alt="" loading="lazy" /></figure>
            <dl class="card about-facts">{facts.slice(0, 2).map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
          </div>
        ) : facts.length > 0 && (
          <dl class="card about-facts" style="padding:28px;align-self:end">{facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
        )}
      </div>
    ) : (
      <div class="about-noimg">
        <div class="card an-name" data-rise>
          <p class="kicker">你好，我是</p>
          <div><p class="an-big">{p.name}</p>{p.nameEn && <p class="an-en">{p.nameEn}</p>}</div>
        </div>
        {facts.length > 0 && <dl class="card about-facts an-facts" data-rise>{facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>}
      </div>
    )}
  </section>

  <section class="about-body">
    <div class="narrow prose" data-rise><Content /></div>
  </section>

  {p.traits.length > 0 && (
    <section class="wrap traits-sec" aria-labelledby="tr-h">
      <header class="sec-head" data-rise><h2 id="tr-h" class="h2">我怎麼做事。</h2></header>
      <div class="traits">
        {p.traits.map((t, i) => (
          <div class="card" data-rise>
            <p class="b-trait-n">{String(i + 1).padStart(2, '0')}</p>
            <p class="b-trait-t">{t.title}</p>
            <p class="b-trait-x">{t.text}</p>
          </div>
        ))}
      </div>
    </section>
  )}

  {p.skills.length > 0 && (
    <section class="wrap skills-sec" aria-labelledby="sk-h">
      <header class="sec-head" data-rise><h2 id="sk-h" class="h2">會用的工具。</h2></header>
      <div class="skills-grid">
        {p.skills.map((s) => (
          <div class="card" data-rise>
            <h3>{s.group}</h3>
            <p class="cnt">{s.items.length} 項</p>
            <p class="chips">{s.items.map((i) => <span>{i}</span>)}</p>
          </div>
        ))}
      </div>
    </section>
  )}

  {p.interests.length > 0 && (
    <section class="wrap interests-sec" aria-labelledby="in-h">
      <header class="sec-head" data-rise><h2 id="in-h" class="h2">下課之後。</h2></header>
      <div class="ints">
        {p.interests.map((t, i) => {
          const [a, b] = t.split(/[：:]/);
          return (
            <div class="card" data-rise>
              <p class="n">{String(i + 1).padStart(2, '0')}</p>
              <div><strong>{a}</strong>{b && <span>{b}</span>}</div>
            </div>
          );
        })}
      </div>
    </section>
  )}

  {p.quote && (
    <section class="quote-band">
      <div class="wrap"><p data-quote>{p.quote}</p><cite>— {p.name}</cite></div>
    </section>
  )}

  <Cta />
</Layout>
<script>
  import { gsap, onReady } from '../../../lib/motion';
  onReady(() => {
    gsap.from('.phead .kicker, [data-intro]', { y: 30, opacity: 0, filter: 'blur(8px)', duration: 1.3, ease: 'expo.out', stagger: 0.1 });
    gsap.from('.about-hero', { y: 90, opacity: 0, duration: 1.5, ease: 'expo.out', delay: 0.3 });
    gsap.from('[data-quote]', { scale: 0.86, opacity: 0.2, ease: 'none', scrollTrigger: { trigger: '.quote-band', start: 'top bottom', end: 'center center', scrub: 0.6 } });
  });
</script>
