---
import Layout from '../Layout.astro';
import Device from '../components/Device.astro';
import Icon from '../components/Icon.astro';
import Phrases from '../components/Phrases.astro';
import { u, img } from '../../../lib/site';
import { isTall } from '../components/imgsize';
import { render } from 'astro:content';
const { entry, index = 0, total = 1, next } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
// 成果：抓出第一個數字當大字（例如「320 位」「3 步」），抓不到就用勾勾
const res = d.results.map((r: string) => {
  const m = r.match(/(\d[\d,.]*\s*(%|倍|位|本|步|秒|筆|場|小時|分鐘|人|個|張)?)/);
  return { big: m ? m[1].replace(/\s+/g, '') : '', text: r };
});
const tall = d.gallery.filter((g: any) => isTall(g.src));
const wide = d.gallery.filter((g: any) => !isTall(g.src));
---
<Layout title={d.title} description={d.summary} image={d.cover} page="project">
  <header class="case-head wrap">
    <a class="crumb" href={u('/projects/')}><Icon name="back" />作品 {String(index + 1).padStart(2, '0')} / {String(total).padStart(2, '0')}</a>
    <h1 class="h1" data-intro><Phrases text={d.title} /></h1>
    <p class="lede" data-intro style="margin:22px auto 0;max-width:30em">{d.summary}</p>
    <p class="case-meta" data-intro>
      {d.role && <span><b>角色</b>{d.role}</span>}
      {d.period && <span><b>期間</b>{d.period}</span>}
      {d.tags.length > 0 && <span><b>工具</b>{d.tags.join('、')}</span>}
    </p>
    {d.links.length > 0 && (
      <div class="btns center case-links" data-intro>
        {d.links.map((l: any, i: number) => <a class:list={['pill', { ghost: i > 0 }]} href={u(l.url)} target="_blank" rel="noopener">{l.label}<Icon name="out" /></a>)}
      </div>
    )}
  </header>

  <div class="case-dev" data-zoom>
    <Device src={d.cover} alt={d.title} eager fb={{ title: d.title, summary: d.summary, tags: d.tags, results: d.results, n: index + 1 }} />
  </div>

  {res.length > 0 && (
    <section class="wrap results" aria-labelledby="res-h">
      <header class="sec-head" data-rise><h2 id="res-h" class="h2">成果。</h2></header>
      <div class="res-grid">
        {res.map((r: any) => (
          <div class="card res" data-rise>
            {r.big ? <strong class="res-big" data-count>{r.big}</strong> : <span class="res-big ic"><Icon name="check" /></span>}
            <p>{r.text}</p>
          </div>
        ))}
      </div>
    </section>
  )}

  <section class="case-body">
    <div class="narrow prose" data-rise><Content /></div>
  </section>

  {d.gallery.length > 0 && (
    <section class="wrap gallery" aria-label="更多畫面">
      {tall.length > 0 && (
        <div class="gal">
          {tall.map((g: any) => (
            <figure class="item" data-rise>
              <Device src={g.src} alt={g.caption || d.title} kind="phone" />
              {g.caption && <figcaption>{g.caption}</figcaption>}
            </figure>
          ))}
        </div>
      )}
      {wide.length > 0 && (
        <div class="gal wide" style={tall.length ? 'margin-top:24px' : ''}>
          {wide.map((g: any) => (
            <figure class="item" data-rise>
              <Device src={g.src} alt={g.caption || d.title} kind="mac" />
              {g.caption && <figcaption>{g.caption}</figcaption>}
            </figure>
          ))}
        </div>
      )}
    </section>
  )}

  {next && next.id !== entry.id && (
    <section class="next-band">
      <a class="wrap next-in" href={u(`/projects/${next.id}/`)}>
        <div>
          <p class="kicker">下一個作品</p>
          <p class="next-t">{next.data.title}</p>
          <span class="tlink">繼續看 <Icon name="chev" /></span>
        </div>
        <div class="next-dev">
          <Device src={next.data.cover} alt="" kind="mac" fb={{ title: next.data.title, summary: next.data.summary, tags: next.data.tags, results: next.data.results, n: ((index + 1) % total) + 1 }} />
        </div>
      </a>
    </section>
  )}
</Layout>
<script>
  import { gsap, onReady } from '../../../lib/motion';
  onReady(() => {
    gsap.from('.crumb, [data-intro]', { y: 30, opacity: 0, filter: 'blur(8px)', duration: 1.3, ease: 'expo.out', stagger: 0.08 });
    gsap.from('.case-dev .mac-screen > *, .case-dev .phone-screen > *', { scale: 1.12, ease: 'none', scrollTrigger: { trigger: '.case-dev', start: 'top bottom', end: 'center center', scrub: 0.6 } });
  });
</script>
