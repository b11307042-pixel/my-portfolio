---
import Layout from '../Layout.astro';
import Icon from '../components/Icon.astro';
import Phrases from '../components/Phrases.astro';
import { getProfile, u, img, fmtDate, readMinutes } from '../../../lib/site';
import { render } from 'astro:content';
const { entry, prev, next } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const p = (await getProfile()).data;
---
<Layout title={d.title} description={d.summary} image={d.cover} page="post">
  <header class="post-head wrap">
    <a class="crumb" href={u('/blog/')}><Icon name="back" />所有文章</a>
    <h1 class="h1" data-intro><Phrases text={d.title} /></h1>
    <p class="post-meta" data-intro>
      <span>{p.name}</span>
      <time datetime={d.date.toISOString()}>{fmtDate(d.date)}</time>
      <span>{readMinutes(entry.body)} 分鐘閱讀</span>
    </p>
    {d.tags.length > 0 && <p class="chips center" data-intro style="margin-top:18px">{d.tags.map((t: string) => <span>{t}</span>)}</p>}
  </header>
  {img(d.cover) && <figure class="post-cover" data-zoom><img src={img(d.cover)} alt="" /></figure>}
  <article class="narrow post-body">
    <p class="post-lede" data-intro>{d.summary}</p>
    <div class="prose"><Content /></div>
  </article>
  {(prev || next) && (
    <nav class="narrow pager" aria-label="其他文章">
      {next && <a class="card" href={u(`/blog/${next.id}/`)}><span class="kicker">上一篇</span><strong>{next.data.title}</strong></a>}
      {prev && <a class="card nx" href={u(`/blog/${prev.id}/`)}><span class="kicker">下一篇</span><strong>{prev.data.title}</strong></a>}
    </nav>
  )}
</Layout>
<script>
  import { gsap, onReady } from '../../../lib/motion';
  onReady(() => {
    gsap.from('.crumb, [data-intro]', { y: 30, opacity: 0, filter: 'blur(8px)', duration: 1.3, ease: 'expo.out', stagger: 0.08 });
  });
</script>
