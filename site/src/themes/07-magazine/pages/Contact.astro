---
import Layout from '../Layout.astro';
import Opener from '../components/Opener.astro';
import ContactForm from '../../../shared/ContactForm.astro';
import { getProfile, u } from '../../../lib/site';
import { folio } from '../components/issue';

const p = (await getProfile()).data;
const page = await folio('/contact/');
---
<Layout title="聯絡" page="contact">
  <Opener kicker="讀者來函" en="Letters" title="讀者來函" lead="實習、合作，或只是想聊聊，都歡迎來信。" folio={page} />

  <section class="ct">
    <div class="ct-letter" data-rise>
      <p class="ct-to">致　{p.name}：</p>
      <ContactForm email={p.email} />
    </div>
    <aside class="ct-side">
      {p.email && (
        <div class="ct-mail" data-rise>
          <p class="ct-k">來信請寄 <span class="it">Write to</span></p>
          <a class="ln-a" href={`mailto:${p.email}`}>{p.email}</a>
        </div>
      )}
      <dl class="sidebox sidebox-meta" data-rise>
        {p.status && <div><dt>近況</dt><dd class="acc">{p.status}</dd></div>}
        {p.location && <div><dt>所在</dt><dd>{p.location}</dd></div>}
        <div><dt>回覆</dt><dd>通常一兩天內</dd></div>
        {p.links.length > 0 && <div><dt>其他</dt><dd class="ff-links">{p.links.map((l) => <a class="ln-a" href={u(l.url)} target="_blank" rel="noopener">{l.label}</a>)}</dd></div>}
      </dl>
    </aside>
  </section>
</Layout>
