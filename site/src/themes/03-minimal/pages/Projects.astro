---
import Layout from '../Layout.astro';
import PageHead from '../components/PageHead.astro';
import QuestCard from '../components/QuestCard.astro';
import Px from '../components/Px.astro';
import { getProjects } from '../../../lib/site';
const projects = await getProjects();
const tags = [...new Set(projects.flatMap((x) => x.data.tags))];
---
<Layout title="作品" page="projects">
  <PageHead stage="STAGE 03" en="QUEST BOARD" title="任務看板" lead="每個作品都是一次完成的任務：截圖是現場，獎勵是做出來的成果。" icon="sword" count={projects.length} countLabel=" 個任務完成" />
  <section class="wrap sec-tight">
    {tags.length > 1 && (
      <div class="filters" role="group" aria-label="依標籤篩選">
        <button type="button" class="fchip on" data-filter="" aria-pressed="true">全部</button>
        {tags.slice(0, 14).map((t) => <button type="button" class="fchip" data-filter={t} aria-pressed="false">{t}</button>)}
      </div>
    )}
    {projects.length > 0 ? (
      <div class="qgrid all">
        {projects.map((x, i) => <div class="qcell" data-tags={x.data.tags.join('|')}><QuestCard entry={x} index={i} rewards={3} /></div>)}
      </div>
    ) : (
      <div class="empty box t-line"><Px name="chest" scale={6} class="bob" /><p>任務還在準備中，很快就會出現。</p></div>
    )}
    <p class="empty-f" data-filter-empty hidden>這個標籤沒有任務。</p>
  </section>
</Layout>
