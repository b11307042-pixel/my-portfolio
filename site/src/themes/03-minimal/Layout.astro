---
// 03 像素冒險：全站外框（星空、HUD 頁首、存檔點頁尾、進場閃屏）
import './styles.css';
import Seo from '../../shared/Seo.astro';
import Header from './components/Header.astro';
import Footer from './components/Footer.astro';
import { config } from '../../lib/site';
interface Props { title?: string; description?: string; image?: string; page?: string; cta?: boolean }
const { title, description, image, page = '', cta = true } = Astro.props;
// 星星：固定亂數種子，每次建置一樣
let seed = 42;
const rnd = () => ((seed = (seed * 16807) % 2147483647) / 2147483647);
const field = (n: number, color: string) => Array.from({ length: n }, () => `${Math.floor(rnd() * 400) * 4}px ${Math.floor(rnd() * 250) * 4}px 0 ${color}`).join(',');
const s1 = field(90, 'rgba(244,241,230,.55)');
const s2 = field(28, '#f4f1e6');
const s3 = field(10, '#ffd166');
---
<!doctype html>
<html lang={config.lang} data-page={page}>
<head>
  <Seo title={title} description={description} image={image} />
</head>
<body>
  <a class="skip" href="#main">跳到內容</a>
  <div class="sky" aria-hidden="true">
    <i class="st st1" style={`box-shadow:${s1}`}></i>
    <i class="st st2" style={`box-shadow:${s2}`}></i>
    <i class="st st3" style={`box-shadow:${s3}`}></i>
  </div>
  <Header />
  <main id="main"><slot /></main>
  <Footer cta={cta} />
  <div class="flash" aria-hidden="true"></div>
  <script>
    import './scripts/pixel';
  </script>
  <script is:inline>if (location.search.includes('shot')) document.querySelectorAll('img[loading=lazy]').forEach((i) => { i.loading = 'eager'; });</script>
</body>
</html>
