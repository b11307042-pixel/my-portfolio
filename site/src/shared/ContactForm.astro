---
// 聯絡表單（共用）：site.config.mjs 的 contactEndpoint 有填就送到 Worker（存進 D1），沒填就顯示寄信按鈕。
// 結構和送出邏輯共用；樣式由風格決定，class：.form .field .btn .form-msg .form-off；送出狀態看 form[data-state]
import { config } from '../lib/site';
interface Props { email?: string }
const { email } = Astro.props;
const endpoint = config.contactEndpoint;
---
{endpoint ? (
  <form class="form" data-contact action={endpoint} method="post">
    <div class="field"><label for="cf-name">你的名字</label><input id="cf-name" name="name" required maxlength="80" autocomplete="name" /></div>
    <div class="field"><label for="cf-email">Email</label><input id="cf-email" name="email" type="email" required maxlength="120" autocomplete="email" /></div>
    <div class="field"><label for="cf-msg">想說的話</label><textarea id="cf-msg" name="message" rows="6" required maxlength="3000"></textarea></div>
    <input class="hp" name="website" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <button class="btn" type="submit">送出</button>
    <p class="form-msg" role="status" aria-live="polite"></p>
  </form>
) : (
  <div class="form form-off">
    <p class="form-off-title">最快的方式是直接寄信</p>
    <p>寫下你是誰、想聊什麼，我通常一兩天內回覆。</p>
    {email && <a class="btn" href={`mailto:${email}`}>寄信給我</a>}
  </div>
)}
<script>
  const form = document.querySelector<HTMLFormElement>('form[data-contact]');
  if (form) {
    const msg = form.querySelector('.form-msg')!;
    const btn = form.querySelector('button')!;
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      btn.disabled = true; msg.textContent = '送出中…'; form.dataset.state = 'sending';
      try {
        const res = await fetch(form.action, { method: 'POST', body: new FormData(form) });
        const data = await res.json().catch(() => ({}));
        if (!res.ok || !data.ok) throw new Error(data.error || '送出失敗');
        form.reset(); form.dataset.state = 'done'; msg.textContent = '收到了，謝謝你！我會盡快回覆。';
      } catch (err) {
        form.dataset.state = 'error'; msg.textContent = `沒送出去：${(err as Error).message}。也可以直接寄信給我。`;
      } finally { btn.disabled = false; }
    });
  }
</script>
